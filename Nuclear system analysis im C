float direcionarCalculoRadioativo(int op)
{
    float N0, A0, l, t, N, E, m, D, w, resultado;
    
    switch(op)  
    {
        case 1:
            lerParametros1(&N0, &l, &t);
            resultado = calcDecaimento(N0, l, t);
            break;
        case 2: 
            lerParametros2(&A0, &l, &t);
            resultado = calcAtividadeTempo(A0, l, t);
            break;
        case 3:
            lerParametros3(&l);
            resultado = calcMeiaVida(l);
            break;
        case 4: 
            lerParametros4(&N, &l);
            resultado = calcAtividade(N, l);
            break;
        case 5:
            lerParametros5(&E, &m);
            resultado = calcDoseAbsorvida(E, m);
            break;
        case 6: 
            lerParametros6(&D, &w);
            resultado = calcDoseEquivalente(D, w);
            break;
        case 7:
            lerParametros1(&N0, &l, &t); 
            resultado = calcNumerodec(N0, l, t);
            break;
        default:
            break;
    }
    return resultado;
//======================================================================================================================
