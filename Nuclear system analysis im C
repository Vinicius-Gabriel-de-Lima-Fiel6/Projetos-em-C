float calcDecaimento(float N0, float l, float t) 
{
	return N0 * expf(-l * t);
	}
float calcAtividadeTempo(float A0, float l, float t) 
{
	return A0 * expf(-l * t);
	}
float calcMeiaVida(float l) {
	return 0.693147f / l;
	}
float calcAtividade(float N, float l) {
	return N * l;
	}
float calcDoseAbsorvida(float E, float m) {
	return E / m;
	}
float calcDoseEquivalente(float D, float w) {
	return D * w;
	}
float calcNumerodec(float N0, float l, float t) {
	return N0 - (N0 * expf(-l * t));
	}
