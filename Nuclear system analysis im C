float calcularDeterminante(float *m, int ordem) 
{
    float res=0,sinal=1,t[25];
    int k=0,cof,i,j;
    if (ordem == 1) return m[0];
    if (ordem == 2) return m[0]*m[3] - m[1]*m[2];

    for (cof = 0; cof < ordem; cof++) 
    {
        for ( i = 1; i < ordem; i++) 
        {
            for (j = 0; j < ordem; j++) 
            {
                if (j == cof) continue; 
                t[k++] = m[i*ordem + j];
            }
        }
        res += sinal * m[cof] * calcularDeterminante(t, ordem - 1);
        sinal = -sinal;
    }
    return res;
}
